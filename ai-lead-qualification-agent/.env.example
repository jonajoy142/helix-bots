LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Only needed if LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Optional - leave blank to fall back to data/leads.csv
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=

# Optional - Zapier/Make/n8n/Slack webhook URL for hot-lead alerts
AUTOMATION_WEBHOOK_URL=

HOT_LEAD_SCORE_THRESHOLD=70
